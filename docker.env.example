DASHBOARD_PORT=3100
BACKEND_PORT=8100
BACKEND_BIND=0.0.0.0
DASHBOARD_BIND=0.0.0.0
BACKEND_INTERNAL_URL=http://backend:8000
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3100
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000
DASHBOARD_ALLOWED_ORIGIN_REGEX=^https?://(?:localhost|127\.0\.0\.1|[a-zA-Z0-9][a-zA-Z0-9.-]*|\d{1,3}(?:\.\d{1,3}){3})(?::(?:3000|3001|3100))$
EXTRACTION_PROVIDER=local
LOCAL_LLM_BASE_URL=http://host.docker.internal:11434
LOCAL_LLM_MODEL=qwen3.5:35b-a3b-q4_K_M
LOCAL_LLM_TIMEOUT_SECONDS=30
LOCAL_LLM_CONTEXT_LENGTH=16384
LOCAL_LLM_MAX_OUTPUT_TOKENS=4096
EXTRACTION_API_BASE_URL=https://api.openai.com/v1
EXTRACTION_API_KEY=
EXTRACTION_API_MODEL=
EXTRACTION_API_TIMEOUT_SECONDS=60
EXTRACTION_MAX_CONCURRENT=6
EXTRACTION_CONCURRENCY_WAIT_SECONDS=10
PHASE2_SKILL_RUNTIME_ENABLED=true
SKILL_AUTO_ENABLE=work-capture,calendar-agent
SKILLS_ROOT=/app/skills
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEOUT_SECONDS=20
TTS_ENABLED=true
TTS_BRIDGE_URL=http://tts:8765
TTS_PUBLIC_BASE_URL=http://127.0.0.1:8766
TTS_PROVIDER_NAME=local-piper
TTS_MODEL_NAME=ko_KR-kss-medium
TTS_TIMEOUT_SECONDS=30
# Optional one-shot fallback. Keep blank when Piper is already the primary.
TTS_FALLBACK_BRIDGE_URL=
TTS_FALLBACK_PUBLIC_BASE_URL=http://127.0.0.1:8766
TTS_FALLBACK_PROVIDER_NAME=local-piper
TTS_FALLBACK_MODEL_NAME=ko_KR-kss-medium
TTS_FALLBACK_TIMEOUT_SECONDS=30
PIPER_VOICE=ko_KR-kss-medium
PIPER_AUTO_DOWNLOAD=true
TTS_PORT=8766
